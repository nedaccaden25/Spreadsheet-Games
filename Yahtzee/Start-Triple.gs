function yahtzeetriple() {
  const sheet = SpreadsheetApp.getActive().getSheetByName('Yahtzee')

  var resetyn = Browser.msgBox('Are you sure you want to start a new triple Yahtzee game?', 'whatever is on the current board will be reset', Browser.Buttons.YES_NO)
  if (resetyn == 'yes') {

  //Set up the helper box
  sheet.getRange('O15').setValue("Welcome to triple YAHTZEE in Google Sheets. This game is a simple variation on the standard YAHTZEE that adds a bit more strategy. It is played the same as a single player game of YAHTZEE with the following differences. Before selecting the row that you would like to score, you must check one of the boxes corresponding to the three columns. The columns are treated entirely seperately, but the second and third columns' scores are doubled and tripled respectively. The final score is simply the three columns' final scores added together.").setFontSize(9)

  //Set up score sheet:
  sheet.getRange('X1:X22').setBackground('#ffffff').setFontSize(10).setFontColor('#000000')
  sheet.getRange('Y1:Y22').setBackground('#ffffff').setFontSize(7).setFontColor('#000000')
  sheet.getRange('Z1:Z22').clearContent().setBackground('#ea9999').setFontSize(14).setFontColor('#000000')
  sheet.getRange('AA1:AA22').clearContent().setBackground('#a4c2f4').setFontSize(14).setFontColor('#000000')
  sheet.getRange('AB1:AB22').clearContent().setBackground('#b6d7a8').setFontSize(14).setFontColor('#000000')
  sheet.getRange('AC1:AC22').clearContent().setBackground('#ffe599').setFontSize(14).setFontColor('#000000')
  sheet.getRange('X10:AC10').clearContent().setBackground('#000000').setFontColor('#000000')
  sheet.getRange('X21:AC21').clearContent().setBackground('#000000').setFontColor('#000000')
  sheet.getRange('X1').setValue('Aces:')
  sheet.getRange('X2').setValue('Twos:')
  sheet.getRange('X3').setValue('Threes:')
  sheet.getRange('X4').setValue('Fours:')
  sheet.getRange('X5').setValue('Fives:')
  sheet.getRange('X6').setValue('Sixes:')
  sheet.getRange('X7').setValue('TOTAL:')
  sheet.getRange('X8').setValue('BONUS:')
  sheet.getRange('X9').setValue('UPPER TOTAL:')
  sheet.getRange('X11').setValue('3 of a Kind:')
  sheet.getRange('X12').setValue('4 of a Kind:')
  sheet.getRange('X13').setValue('Full House:')
  sheet.getRange('X14').setValue('Small Straight:')
  sheet.getRange('X15').setValue('Large Straight:')
  sheet.getRange('X16').setValue('YAHTZEE:')
  sheet.getRange('X17').setValue('Chance:')
  sheet.getRange('X18').setValue('YAHTZEE BONUS:')
  sheet.getRange('X19').setValue('UPPER TOTAL:')
  sheet.getRange('X20').setValue('LOWER TOTAL:')
  sheet.getRange('X22').setValue('GRAND TOTAL:')
  sheet.getRange('Y1').setValue('Add all aces')
  sheet.getRange('Y2').setValue('Add all twos')
  sheet.getRange('Y3').setValue('Add all threes')
  sheet.getRange('Y4').setValue('Add all fours')
  sheet.getRange('Y5').setValue('Add all fives')
  sheet.getRange('Y6').setValue('Add all sixes')
  sheet.getRange('Y7').setValue('→').setFontSize(19)
  sheet.getRange('Y8').setValue('If the total is at least 63, score 35')
  sheet.getRange('Y9').setValue('→').setFontSize(19)
  sheet.getRange('Y11:Y12').setValue('Add all dice')
  sheet.getRange('Y13').setValue('Score 25')
  sheet.getRange('Y14').setValue('Score 30')
  sheet.getRange('Y15').setValue('Score 40')
  sheet.getRange('Y16').setValue('Score 50')
  sheet.getRange('Y17').setValue('Add all dice')
  sheet.getRange('Y18').setValue('If a YAHTZEE has been scored, mark a box and score 100').setFontSize(6)
  sheet.getRange('Y19:Y20').setValue('→').setFontSize(19)
  sheet.getRange('Y22').setValue('→').setFontSize(19)

  //Specify the multipliers of the columns:
  sheet.getRange('Z10').setValue('X1').setFontColor('#ffffff').setFontSize(12)
  sheet.getRange('AA10').setValue('X2').setFontColor('#ffffff').setFontSize(12)
  sheet.getRange('AB10').setValue('X3').setFontColor('#ffffff').setFontSize(12)
  sheet.getRange('Z21').setValue('X1').setFontColor('#ffffff').setFontSize(12)
  sheet.getRange('AA21').setValue('X2').setFontColor('#ffffff').setFontSize(12)
  sheet.getRange('AB21').setValue('X3').setFontColor('#ffffff').setFontSize(12)
  sheet.getRange('AC10').setValue(0)

  //Set up the triple specific area
  sheet.getRange('AC1:AC21').setBackground('#000000')
  sheet.getRange('AC1').setValue('Board').setFontColor('#ea9999')
  sheet.getRange('AC2').setValue('1').setFontColor('#ea9999')
  sheet.getRange('AC3').insertCheckboxes().setFontColor('#ea9999')
  sheet.getRange('AC4').setValue('Board').setFontColor('#a4c2f4')
  sheet.getRange('AC5').setValue('2').setFontColor('#a4c2f4')
  sheet.getRange('AC6').insertCheckboxes().setFontColor('#a4c2f4')
  sheet.getRange('AC7').setValue('Board').setFontColor('#b6d7a8')
  sheet.getRange('AC8').setValue('3').setFontColor('#b6d7a8')
  sheet.getRange('AC9').insertCheckboxes().setFontColor('#b6d7a8')
  sheet.getRange('AC18').setValue('TRUE').setFontColor('#ffffff').setFontSize(10)
  sheet.getRange('AC19').setValue('GRAND').setFontColor('#ffffff').setFontSize(10)
  sheet.getRange('AC20').setValue('TOTAL:').setFontColor('#ffffff').setFontSize(10)
  sheet.getRange('AC22').setBackground('#ffffff')
  


  //Set up the dice rolling area:
  sheet.getRange('A1:U5').clearContent().setBackground('#ea9999').setFontColor('#000000')
  sheet.getRange('B6').setBackground('#ea9999').setFontColor('#000000').setFontSize(26).insertCheckboxes().uncheck()
  sheet.getRange('B7').setValue('Keep').setBackground('#ffffff').setFontColor('#000000').setFontSize(15)
  sheet.getRange('F6').setBackground('#ea9999').setFontColor('#000000').setFontSize(26).insertCheckboxes().uncheck()
  sheet.getRange('F7').setValue('Keep').setBackground('#ffffff').setFontColor('#000000').setFontSize(15)
  sheet.getRange('J6').setBackground('#ea9999').setFontColor('#000000').setFontSize(26).insertCheckboxes().uncheck()
  sheet.getRange('J7').setValue('Keep').setBackground('#ffffff').setFontColor('#000000').setFontSize(15)
  sheet.getRange('N6').setBackground('#ea9999').setFontColor('#000000').setFontSize(26).insertCheckboxes().uncheck()
  sheet.getRange('N7').setValue('Keep').setBackground('#ffffff').setFontColor('#000000').setFontSize(15)
  sheet.getRange('R6').setBackground('#ea9999').setFontColor('#000000').setFontSize(26).insertCheckboxes().uncheck()
  sheet.getRange('R7').setValue('Keep').setBackground('#ffffff').setFontColor('#000000').setFontSize(15)
  sheet.getRange('B2:D4').setBackground('#000000').setFontColor('#ffffff').setFontSize(19)
  sheet.getRange('F2:H4').setBackground('#000000').setFontColor('#ffffff').setFontSize(19)
  sheet.getRange('J2:L4').setBackground('#000000').setFontColor('#ffffff').setFontSize(19)
  sheet.getRange('N2:P4').setBackground('#000000').setFontColor('#ffffff').setFontSize(19)
  sheet.getRange('R2:T4').setBackground('#000000').setFontColor('#ffffff').setFontSize(19)
  sheet.getRange('A1').setValue('Roll Attempt')
  sheet.getRange('D1').setValue(0)
  }
}
